######################################################################################
# Gaia configuration. Copy to .env (the installer does this for you) and fill in.
# Only DISCORD_TOKEN is required; everything else is optional.
######################################################################################

# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (General Information page). Optional safety check that the token matches.
APPLICATION_ID=
# Where the SQLite database lives (ignored in Docker, which uses /app/data/gaia.sqlite).
DATABASE_PATH=./data/gaia.sqlite

######################################################################################
# TIME
######################################################################################

# IANA timezone for scheduled embeds, the daily backup and displayed dates.
# Examples: UTC, Europe/London, America/New_York, Asia/Tokyo. Default: Europe/Ljubljana.
TIMEZONE=
# Local hour (0-23) when the daily automatic backup runs, if enabled in /admin. Default: 3.
BACKUP_HOUR=

######################################################################################
# JOIN / LEAVE LOG (optional, operator-wide)
######################################################################################

MEMBER_LOG_CHANNEL=
MEMBER_LOG_WEBHOOK_URL=

######################################################################################
# STAFF / AUDIT LOG (optional, operator-wide)
######################################################################################

LOG_GUILD=
LOG_GUILD_CHANNEL=
LOG_WEBHOOK_URL=

######################################################################################
# DIAGNOSTICS (optional, used by `rake commands:inspect`)
######################################################################################

DIAGNOSTIC_GUILD_ID=
DIAGNOSTIC_USER_ID=
