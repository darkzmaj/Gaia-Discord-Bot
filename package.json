{
  "name": "cookie-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings=0",
    "migrate": "tsx src/db/migrate.ts",
    "commands:sync": "tsx src/commands-sync.ts",
    "commands:sync:dry": "tsx src/commands-sync.ts --dry-run",
    "commands:inspect": "tsx src/commands-inspect.ts"
  },
  "engines": { "node": ">=20.17" },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
